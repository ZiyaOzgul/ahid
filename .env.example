# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional for server-side privileged operations when RLS is enabled:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Authentication & Signing Secret (Required in production, >= 32 chars)
AUTH_SECRET=replace-with-at-least-64-hex-characters-random-secret

# Optional Public Site Base URL (used for sitemap, metadata, QR verification URLs)
NEXT_PUBLIC_SITE_URL=https://www.ahid.org.tr

# Optional Transactional Email Provider (Resend)
RESEND_API_KEY=
EMAIL_FROM=AHID Kurumsal <bildirim@ahid.org.tr>
